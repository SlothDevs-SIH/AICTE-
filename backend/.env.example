# SQLite for local use; on a host use the PostgreSQL address it gives you (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=sqlite:///./data/samanvay.db
# DEMO_ACCOUNTS=true   (local only: switches on the generated demo logins; the password is published in the README)
SECRET_KEY=change-me
PII_ENCRYPTION_KEY=change-me-with-a-fernet-key
ENVIRONMENT=dev
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Optional: language-model reading of different wording (also needs the Admin switch)
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash

# Sign-up e-mail verification. One of: BREVO_API_KEY, RESEND_API_KEY, or SMTP_HOST (+ SMTP_PORT, SMTP_USER, SMTP_PASSWORD)
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=SAMANVAY
# PUBLIC_BASE_URL=https://your-site.example   (the address used inside the verification link)
# ADMIN_EMAILS=you@example.org                (these addresses become administrators when they verify)
# DEV_SHOW_VERIFY_LINK=true                   (testing only: shows the link on screen when no mail service is set)

# Bot check on sign-up and password reset (Cloudflare Turnstile, free). Both keys, or neither.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
